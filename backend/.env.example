PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sanad
APP_JWT_SECRET=change_me_super_secret

# Supabase JWT validation
SUPABASE_PROJECT_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# API behavior
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Scheduler
ENABLE_INGESTION_SCHEDULER=false
INGESTION_CRON=0 */3 * * *

# Gemini placeholder (for future ingestion classifier)
GEMINI_API_KEY=
